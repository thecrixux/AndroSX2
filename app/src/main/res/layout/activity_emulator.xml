<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EmulatorActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/emulatorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="#00000000"
            android:backgroundTint="@color/black">
            <!-- Partie gauche -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="left|bottom"
                android:orientation="vertical"
                android:padding="15dp">
                <!-- DPAD -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="right|bottom"
                    android:orientation="vertical">

                    <!-- Top -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPadUp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text=""
                            app:icon="@drawable/touch_top"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="50dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>

                    <!-- Left/Right -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPadLeft"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text=""
                            app:icon="@drawable/touch_left"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="50dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPadRight"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text=""
                            app:icon="@drawable/touch_right"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="50dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>

                    <!-- UP/DOWN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPadDown"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text=""
                            app:icon="@drawable/touch_bottom"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="50dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Partie Centrale -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="top"
                android:orientation="vertical"
                android:padding="15dp">

                <!-- Start/Select -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonStart"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:backgroundTint="#3B000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="0dp"
                        android:layout_marginRight="6dp"
                        android:text="Start"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        app:rippleColor="#80808080"
                        app:strokeColor="#00000000" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSelect"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:backgroundTint="#3B000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="0dp"
                        android:text="Select"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        app:rippleColor="#80808080"
                        app:strokeColor="#00000000" />
                </LinearLayout>
            </LinearLayout>

            <!-- Partie droite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="right|bottom"
                android:orientation="vertical"
                android:padding="15dp">
                <!-- Container Boutons (L1/R1 L2/R2 L3/R3) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="right|bottom"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <!-- L3/R3 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonL3"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/press_l3"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonR3"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/press_r3"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>

                    <!-- L2/R2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonL2"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/plain_rectangle_l2"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonR2"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/plain_rectangle_r2"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>

                    <!-- L1/R1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonL1"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/plain_rectangle_l1"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonR1"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/plain_rectangle_r1"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="@null"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>
                </LinearLayout>
                <!-- Container Boutons (XYBA)-->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- XY -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSquare"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/outline_purple_square"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="#D98CB2"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonTriangle"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/outline_green_triangle"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="#08BFB5"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCross"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/outline_blue_cross"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="#8290BA"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCircle"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#3B000000"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:text=""
                            app:icon="@drawable/outline_red_circle"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="40dp"
                            app:iconTint="#D65C5C"
                            app:rippleColor="#80808080"
                            app:strokeColor="#00000000" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>